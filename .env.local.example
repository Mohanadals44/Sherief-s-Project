# Execution mode: auto | cli | files
# - auto (default): detect the Cursor CLI at boot. If installed and logged in, run in automated 'cli' mode.
#                   Otherwise fall back to 'files' mode where the app writes prompt-pack .md files you run manually.
# - cli:   force CLI mode (orchestrator will error if 'agent' binary isn't installed or logged in).
# - files: force prompt-pack mode even if the CLI is available.
# CURSOR_EXECUTION_MODE=auto

# Optional override for the 'agent' CLI binary path (used if the auto-detected locations don't match your install).
# CURSOR_AGENT_PATH=/usr/local/bin/agent

# Optional: where to store the SQLite DB (default: ./data/app.db)
# DATABASE_URL=./data/app.db
